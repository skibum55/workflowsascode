# Use Codespaces secrets or export variables; this file is a template only.
# A public REST API key, not the n8n MCP bearer token.
N8N_BASE_URL=https://oauth2test.manageddeployment.com
N8N_API_KEY=
# Explicit execution ID is mandatory for capture. Never defaults to latest.
N8N_EXECUTION_ID=
# Default tests replay the checked-in, sanitized historical baseline.
# After capture, set this to private/execution-<id>.json.
# SYNC_EVIDENCE=private/execution-35909.json
